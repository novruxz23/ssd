{
  "expo": {
    "name": "Wisp Browser",
    "slug": "wisp-browser",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0a0c",
    "icon": "./assets/icon.png",
    "plugins": [
      ["expo-splash-screen", { "backgroundColor": "#0a0a0c", "image": "./assets/splash.png", "imageWidth": 10 }]
    ],
    "android": {
      "package": "com.wisp.browser",
      "permissions": ["INTERNET"],
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive.png", "backgroundColor": "#0a0a0c" }
    },
    "ios": { "bundleIdentifier": "com.wisp.browser" }
  }
}
